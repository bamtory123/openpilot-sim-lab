+def broken_line_segments(polyline, segment_length, gap_length):
+    """Return exact-distance dash segments from a sampled road-line polyline."""
+    points = np.asarray(polyline, dtype=np.float64)
+    if len(points) < 2:
+        return []
+    lengths = np.linalg.norm(np.diff(points, axis=0), axis=1)
+    cumulative = np.concatenate(([0.0], np.cumsum(lengths)))
+
+    def interpolate(distance):
+        distance = min(max(float(distance), 0.0), float(cumulative[-1]))
+        index = min(int(np.searchsorted(cumulative, distance, side="right") - 1), len(lengths) - 1)
+        if lengths[index] == 0:
+            return points[index].tolist()
+        ratio = (distance - cumulative[index]) / lengths[index]
+        return (points[index] + ratio * (points[index + 1] - points[index])).tolist()
+
+    period = float(segment_length) + float(gap_length)
+    return [[interpolate(start), interpolate(min(start + segment_length, cumulative[-1]))]
+            for start in np.arange(0.0, cumulative[-1], period) if start < cumulative[-1]]
+
+
